# Add project specific ProGuard rules here.
# You can control the set of applied configuration files using the
# proguardFiles setting in build.gradle.
#
# For more details, see
#   http://developer.android.com/guide/developing/tools/proguard.html

# Base Ads Module ProGuard Rules

# Keep Google Mobile Ads SDK classes
-keep class com.google.android.gms.ads.** { *; }
-keep class com.google.ads.mediation.** { *; }
-dontwarn com.google.android.gms.ads.**
-dontwarn com.google.ads.mediation.**

# Keep Vungle (Liftoff) SDK classes
-keep class com.vungle.** { *; }
-keep class com.liftoff.** { *; }
-dontwarn com.vungle.**
-dontwarn com.liftoff.**

# Keep ironSource SDK classes
-keep class com.ironsource.** { *; }
-keep class com.unity3d.** { *; }
-dontwarn com.ironsource.**
-dontwarn com.unity3d.**

# Keep Meta Audience Network (Facebook) SDK classes
-keep class com.facebook.ads.** { *; }
-keepclassmembers class com.facebook.ads.** { *; }
-dontwarn com.facebook.ads.**
-dontwarn com.facebook.infer.annotation.**
-keep class com.facebook.infer.annotation.** { *; }

# Keep InMobi SDK classes
-keep class com.inmobi.** { *; }
-keepclassmembers class com.inmobi.** { *; }
-dontwarn com.inmobi.**
-keep class com.inmobi.ads.** { *; }
-keep interface com.inmobi.ads.** { *; }

# Firebase
-keep class com.google.firebase.** { *; }
-dontwarn com.google.firebase.**

# BaseAds
-keep class com.tinhtx.baseads.** { *; }
-dontwarn com.tinhtx.baseads.**

# Hilt
-keep class dagger.hilt.** { *; }
-keep class javax.inject.** { *; }
-keep class * extends dagger.hilt.android.HiltAndroidApp

# Compose
-keep class androidx.compose.** { *; }
-dontwarn androidx.compose.**

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Uncomment this to preserve the line number information for
# debugging stack traces.
-keepattributes SourceFile,LineNumberTable

# If you keep the line number information, uncomment this to
# hide the original source file name.
-renamesourcefileattribute SourceFile

# Keep our application class
-keep class com.hdcorporation.cleanerproject.UltimateCleanerApplication { *; }

# Hilt ProGuard rules
-keep class dagger.hilt** { *; }
-keep class javax.inject** { *; }
-keep class * extends dagger.hilt.android.lifecycle.HiltViewModel {
    <init>(...);
}
-keep @dagger.hilt.android.lifecycle.HiltViewModel class * { *; }

# Keep all classes annotated with @AndroidEntryPoint
-keep @dagger.hilt.android.AndroidEntryPoint class * { *; }

# Keep all classes annotated with @HiltAndroidApp
-keep @dagger.hilt.android.HiltAndroidApp class * { *; }

# Keep all modules
-keep @dagger.Module class * { *; }
-keep @dagger.hilt.InstallIn class * { *; }
-keep @dagger.hilt.components.SingletonComponent class * { *; }

# Room ProGuard rules
-keep class * extends androidx.room.RoomDatabase { *; }
-keep @androidx.room.Entity class * { *; }
-keep @androidx.room.Dao class * { *; }
-keep @androidx.room.Database class * { *; }
-dontwarn androidx.room.paging.**

# Keep Room generated classes
-keep class com.hdcorporation.cleanerproject.data.database** { *; }
-keep class com.hdcorporation.cleanerproject.data.model** { *; }

# Gson ProGuard rules
-keepattributes Signature
-keepattributes *Annotation*
-dontwarn sun.misc**
-keep class com.google.gson** { *; }
-keep class * implements com.google.gson.TypeAdapterFactory
-keep class * implements com.google.gson.JsonSerializer
-keep class * implements com.google.gson.JsonDeserializer

# Keep reflection-based mediation calls
-keepclassmembers class ** {
    @com.google.android.gms.ads.mediation.** *;
}

# Keep our data models for Gson
-keep class com.hdcorporation.cleanerproject.data.model** { <fields>; }

# Jetpack Compose rules
-keep class androidx.compose** { *; }
-keep class kotlin.Metadata { *; }
-keepclassmembers class kotlin.Metadata {
    public <methods>;
}

# Keep ViewModel classes
-keep class * extends androidx.lifecycle.ViewModel {
    <init>(...);
}
-keep class com.hdcorporation.cleanerproject.presentation.viewmodel** { *; }

# WorkManager rules (updated for our project)
-keep class * extends androidx.work.Worker
-keep class * extends androidx.work.InputMerger
-keep class androidx.work.impl** { *; }
-dontwarn androidx.work.impl**

# Coroutines rules
-keepnames class kotlinx.coroutines.internal.MainDispatcherFactory {}
-keepnames class kotlinx.coroutines.CoroutineExceptionHandler {}
-keepclassmembernames class kotlinx** {
    volatile <fields>;
}

# Navigation Compose rules (since we're using Compose Navigation)
-keep class androidx.navigation** { *; }
-keepnames class androidx.navigation.compose** { *; }

# Keep all classes in our main package
-keep class com.hdcorporation.cleanerproject** { *; }

# Keep enum classes
-keepclassmembers enum com.hdcorporation.cleanerproject** {
    public static **[] values();
    public static ** valueOf(java.lang.String);
}

# Kotlin serialization
-keepattributes RuntimeVisibleAnnotations,AnnotationDefault

# Remove logging in release builds
-assumenosideeffects class android.util.Log {
    public static boolean isLoggable(java.lang.String, int);
    public static int v(...);
    public static int i(...);
    public static int w(...);
    public static int d(...);
    public static int e(...);
}

# Keep line numbers for crash reports
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile

# General Android rules
-keep public class * extends android.app.Activity
-keep public class * extends android.app.Application
-keep public class * extends android.app.Service
-keep public class * extends android.content.BroadcastReceiver
-keep public class * extends android.content.ContentProvider

# Keep native methods
-keepclasseswithmembernames class * {
    native <methods>;
}

# Keep custom view constructors
-keepclasseswithmembers class * {
    public <init>(android.content.Context, android.util.AttributeSet);
}
-keepclasseswithmembers class * {
    public <init>(android.content.Context, android.util.AttributeSet, int);
}

# Keep parcelable classes
-keep class * implements android.os.Parcelable {
    public static final android.os.Parcelable$Creator *;
}

# Keep serializable classes
-keepclassmembers class * implements java.io.Serializable {
    static final long serialVersionUID;
    private static final java.io.ObjectStreamField[] serialPersistentFields;
    private void writeObject(java.io.ObjectOutputStream);
    private void readObject(java.io.ObjectInputStream);
    java.lang.Object writeReplace();
    java.lang.Object readResolve();
}

# Coil image loading library
-keep class coil** { *; }
-keep interface coil** { *; }

# Accompanist permissions
-keep class com.google.accompanist.permissions** { *; }

# Hilt Work integration
-keep class androidx.hilt.work** { *; }

# KSP and annotation processing
-keep class kotlin.annotation** { *; }
-keepattributes *Annotation*

# Additional safety rules for our specific project
-keep class com.hdcorporation.cleanerproject.MainActivity { *; }
-keep class com.hdcorporation.cleanerproject.presentation.ui** { *; }
-keep class com.hdcorporation.cleanerproject.domain.service** { *; }

# =============================================================================
# CRITICAL: AdMob, IronSource & UMP ProGuard Rules for Google Play Policy
# =============================================================================

# AdMob/Google Mobile Ads SDK
-keep class com.google.ads.mediation** { *; }
-keep class com.google.android.gms.ads** { *; }
-keep class com.google.android.gms.ads.identifier** { *; }
-keep class com.google.android.gms.common** { *; }
-dontwarn com.google.android.gms.ads**

# User Messaging Platform (UMP) - CRITICAL for GDPR compliance
-keep class com.google.android.ump** { *; }
-dontwarn com.google.android.ump**

# Google Play Services Advertising ID - REQUIRED for Google Play Policy
-keep class com.google.android.gms.ads.identifier.AdvertisingIdClient { *; }
-keep class com.google.android.gms.ads.identifier.AdvertisingIdClient$Info { *; }

# Firebase Analytics & Crashlytics
-keep class com.google.firebase** { *; }
-keep class com.google.android.gms.measurement** { *; }
-dontwarn com.google.firebase**

# Prevent obfuscation of our advertising helpers
-keep class com.hdcorporation.cleanerproject.utils.AdvertisingIdHelper { *; }
-keep class com.hdcorporation.cleanerproject.consent.ConsentManager { *; }

# ========================================
# BỔ SUNG: AdMob eCPM & Callback Rules
# Thêm vào: 2024-11-04
# ========================================

# CRITICAL: OnPaidEventListener cho eCPM tracking
-keep class ** implements com.google.android.gms.ads.OnPaidEventListener { *; }
-keepclassmembers class ** {
    *** onPaidEvent(...);
}

# AdListener callbacks
-keep class ** extends com.google.android.gms.ads.AdListener { *; }

# FullScreenContentCallback (interstitial/rewarded)
-keep class ** extends com.google.android.gms.ads.FullScreenContentCallback { *; }

# Additional mediation adapter attributes
-keepattributes InnerClasses
-keepattributes EnclosingMethod

# ========================================
# CRITICAL FIX: Mediation Adapter Reflection Support
# Fix cho IronSource & Meta eCPM = "-" trong release build
# Thêm vào: 2024-11-12
# ========================================

# Keep ALL mediation adapter implementations (CRITICAL!)
-keep class * implements com.google.android.gms.ads.mediation.MediationAdapter { *; }
-keep class * implements com.google.android.gms.ads.mediation.Adapter { *; }
-keep class * implements com.google.android.gms.ads.mediation.MediationBannerAdapter { *; }
-keep class * implements com.google.android.gms.ads.mediation.MediationInterstitialAdapter { *; }
-keep class * implements com.google.android.gms.ads.mediation.MediationRewardedAd { *; }
-keep class * implements com.google.android.gms.ads.mediation.rtb.RtbAdapter { *; }

# Keep adapter constructors (AdMob dùng reflection để khởi tạo)
-keepclassmembers class * implements com.google.android.gms.ads.mediation.** {
    public <init>();
    public <init>(...);
}

# Keep adapter initialization methods
-keepclassmembers class * implements com.google.android.gms.ads.mediation.** {
    public void initialize(...);
    public void loadAd(...);
    public void showAd(...);
}

# ========================================
# ENHANCED: IronSource Adapter Rules
# ========================================

# Keep IronSource mediation adapter package (CRITICAL!)
-keep class com.google.ads.mediation.ironsource.** { *; }
-keep interface com.google.ads.mediation.ironsource.** { *; }

# Keep IronSource adapter classes
-keepclassmembers class com.ironsource.** {
    public *;
    protected *;
}

# Keep IronSource interfaces
-keep interface com.ironsource.** { *; }

# Keep LevelPlay SDK classes (IronSource rebranding)
-keep class com.ironsource.mediationsdk.** { *; }
-keep class com.ironsource.adapters.** { *; }
-keep class com.ironsource.lifecycle.** { *; }

# Keep IronSource listener/callback interfaces
-keep class * implements com.ironsource.mediationsdk.** { *; }

# ========================================
# ENHANCED: Meta (Facebook) Adapter Rules
# ========================================

# Keep Meta mediation adapter package (CRITICAL!)
-keep class com.google.ads.mediation.facebook.** { *; }
-keep interface com.google.ads.mediation.facebook.** { *; }

# Keep Meta Audience Network classes
-keepclassmembers class com.facebook.ads.** {
    public *;
    protected *;
}

# Keep Meta Ad interfaces (CRITICAL!)
-keep class * implements com.facebook.ads.Ad { *; }
-keep class * implements com.facebook.ads.AdListener { *; }
-keep interface com.facebook.ads.Ad { *; }
-keep interface com.facebook.ads.AdListener { *; }

# Keep Meta InterstitialAd, RewardedVideoAd classes
-keep class com.facebook.ads.InterstitialAd { *; }
-keep class com.facebook.ads.RewardedVideoAd { *; }
-keep class com.facebook.ads.AdView { *; }

# ========================================
# ENHANCED: Vungle (LiftOff) Adapter Rules
# ========================================

# Keep Vungle mediation adapter package
-keep class com.google.ads.mediation.vungle.** { *; }
-keep interface com.google.ads.mediation.vungle.** { *; }

# Keep Vungle SDK classes
-keepclassmembers class com.vungle.** {
    public *;
    protected *;
}

# ========================================
# ENHANCED: InMobi Adapter Rules
# ========================================

# Keep InMobi mediation adapter package
-keep class com.google.ads.mediation.inmobi.** { *; }
-keep interface com.google.ads.mediation.inmobi.** { *; }

# Keep InMobi SDK internal classes
-keep class com.inmobi.media.** { *; }
-dontwarn com.inmobi.media.**

# ========================================
# CRITICAL: Adapter Version & Info Classes
# ========================================

# Keep adapter version classes (AdMob cần để verify compatibility)
-keep class com.google.ads.mediation.**.BuildConfig { *; }
-keepclassmembers class com.google.ads.mediation.** {
    public static final java.lang.String ADAPTER_VERSION;
    public static final java.lang.String VERSION_NAME;
}

# Keep adapter info classes
-keep class com.google.android.gms.ads.mediation.VersionInfo { *; }
-keepclassmembers class * {
    public com.google.android.gms.ads.mediation.VersionInfo getVersionInfo();
    public com.google.android.gms.ads.mediation.VersionInfo getSDKVersionInfo();
}